// Print the entry a project makes for itself:
//   research-rag --project-root <project> doctor --mcp-entry
// Check one already in place, without editing it:
//   research-rag --project-root <project> doctor --check-entry <this file>
//
// This entry is the stdio bridge, so it starts the app for the project if it is
// not up. Add `--runtime-root` only when a project keeps its derived state on
// another device.
{
  "mcp": {
    "research-rag": {
      "type": "local",
      "command": [
        "/ABSOLUTE/PATH/TO/research-rag/.venv/bin/research-rag",
        "--project-root",
        "/ABSOLUTE/PATH/TO/MY-RESEARCH-PROJECT",
        "mcp"
      ],
      "environment": {},
      "enabled": true,
      "timeout": 3600000
    }
  }
}
