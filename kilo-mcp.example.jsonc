// Print the entry a project makes for itself:
//   research-rag --project-root <project> doctor --mcp-entry
// Check one already in place, without editing it:
//   research-rag --project-root <project> doctor --check-entry <this file>
//
// This entry is the stdio bridge, which starts nothing: the app runs in a
// terminal and ends when that terminal closes, so a client arriving while the
// project is not served is told which command to run. It names the project and
// not its directory, so the same entry serves
// the project on every machine where it was initialised. The `mcp` command comes
// before its own options, which is the only order the parser accepts. Replace
// the executable path and the project name. Add `--runtime-root` only when a
// project keeps its derived state on another device.
{
  "mcp": {
    "research-rag": {
      "type": "local",
      "command": [
        "/ABSOLUTE/PATH/TO/research-rag/.venv/bin/research-rag",
        "mcp",
        "--project-name",
        "MY-RESEARCH-PROJECT"
      ],
      "environment": {},
      "enabled": true,
      "timeout": 3600000
    }
  }
}
